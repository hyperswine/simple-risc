+{-# LANGUAGE DataKinds, NoImplicitPrelude #-}
+{-# OPTIONS_GHC -Wno-missing-export-lists #-}
+module DspCycleTop where
+import Clash.Prelude
+import qualified SimpleRisc as R
+import qualified SdramPipeline as P
+
+{-# ANN topEntity (Synthesize {t_name="sdram_pipeline_core", t_inputs=[PortName "clk",PortName "reset",PortName "enable",PortName "uart_rx",PortName "memory_data",PortName "memory_hold",PortName "sd_miso",PortName "cycle_lo",PortName "cycle_hi",PortName "cycle_carry"], t_output=PortProduct "" [PortProduct "" [PortName "uart_tx",PortName "memory_address",PortName "memory_write",PortName "memory_wdata",PortName "memory_mask",PortName "sd_sck",PortName "sd_mosi",PortName "sd_cs"],PortProduct "" [PortName "cycle_write_valid",PortName "cycle_write_high",PortName "cycle_write_value"]]}) #-}
+topEntity :: Clock XilinxSystem -> Reset XilinxSystem -> Enable XilinxSystem -> Signal XilinxSystem Bit -> Signal XilinxSystem R.Word32 -> Signal XilinxSystem Bool -> Signal XilinxSystem Bit -> Signal XilinxSystem R.Word32 -> Signal XilinxSystem R.Word32 -> Signal XilinxSystem Bool -> (P.BoardOutput XilinxSystem, (Signal XilinxSystem Bool,Signal XilinxSystem Bool,Signal XilinxSystem R.Word32))
+topEntity clk rst en rx dat held miso lo hi carry = withClockResetEnable clk rst en $
+ let (o,t,w)=P.circuitWithExternalCycle rx dat held miso (R.Counter64 <$> lo <*> hi <*> carry)
+     (v,h,d)=unbundle w
+ in (o,(v,h,d))
+
+{-# ANN observedTop (Synthesize {t_name="sdram_pipeline_core", t_inputs=[PortName "clk",PortName "reset",PortName "enable",PortName "uart_rx",PortName "memory_data",PortName "memory_hold",PortName "sd_miso",PortName "cycle_lo",PortName "cycle_hi",PortName "cycle_carry"], t_output=PortProduct "" [PortProduct "" [PortName "uart_tx",PortName "memory_address",PortName "memory_write",PortName "memory_wdata",PortName "memory_mask",PortName "sd_sck",PortName "sd_mosi",PortName "sd_cs"],PortProduct "" [PortName "observe_commit",PortName "observe_word",PortName "observe_pc",PortName "observe_next_pc",PortName "observe_issue",PortName "observe_fetch_pc",PortName "observe_empty",PortName "observe_redirect"],PortProduct "" [PortName "cycle_write_valid",PortName "cycle_write_high",PortName "cycle_write_value"]]}) #-}
+observedTop :: Clock XilinxSystem -> Reset XilinxSystem -> Enable XilinxSystem -> Signal XilinxSystem Bit -> Signal XilinxSystem R.Word32 -> Signal XilinxSystem Bool -> Signal XilinxSystem Bit -> Signal XilinxSystem R.Word32 -> Signal XilinxSystem R.Word32 -> Signal XilinxSystem Bool -> (P.BoardOutput XilinxSystem, (Signal XilinxSystem Bool,Signal XilinxSystem R.Word32,Signal XilinxSystem R.Word32,Signal XilinxSystem R.Word32,Signal XilinxSystem Bool,Signal XilinxSystem R.Word32,Signal XilinxSystem Bool,Signal XilinxSystem Bool), (Signal XilinxSystem Bool,Signal XilinxSystem Bool,Signal XilinxSystem R.Word32))
+observedTop clk rst en rx dat held miso lo hi carry = withClockResetEnable clk rst en $
+ let (o,t,w)=P.circuitWithExternalCycle rx dat held miso (R.Counter64 <$> lo <*> hi <*> carry)
+     (v,h,d)=unbundle w
+ in (o,(R.ptCommit <$> t,R.ptWord <$> t,R.ptPc <$> t,R.ptNextPc <$> t,R.ptIssue <$> t,R.ptFetchPc <$> t,R.ptEmpty <$> t,R.ptRedirect <$> t),(v,h,d))
