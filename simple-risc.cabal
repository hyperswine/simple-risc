cabal-version: 3.0
name:           simple-risc
version:        0.1.0.0
synopsis:       SimpleRisc: an RV32IM(C) soft core in Clash, and its Tang Nano 20K boards
description:    Please see the README on GitHub at <https://github.com/hyperswine/simple-risc#readme>
homepage:       https://github.com/hyperswine/simple-risc#readme
bug-reports:    https://github.com/hyperswine/simple-risc/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    boards/tangnano20k/README.md

source-repository head
  type: git
  location: https://github.com/hyperswine/simple-risc

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules
    -Wpartial-fields -Wredundant-constraints
  default-language: Haskell2010

common deps
  build-depends:
        base >=4.7 && <5
      , clash-prelude
      , containers
      , ghc-typelits-extra
      , ghc-typelits-knownnat
      , ghc-typelits-natnormalise
      , template-haskell

library
  import: warnings, deps
  hs-source-dirs: src
  exposed-modules:
        PsramRegs
      , RiscVCompressed
      , SdramPipeline
      , SdramSimpleRisc
      , SimpleRisc
      , SimpleRisc.Types
      , SimpleRisc.Uart
      , SimpleRisc.Decode

-- The Clash compiler, for the board builds: cabal run clash -- <file> --verilog
executable clash
  import: warnings
  main-is: Clash.hs
  hs-source-dirs: bin
  build-depends: base, clash-ghc
  ghc-options: -threaded -rtsopts

test-suite simple-risc-test
  import: warnings, deps
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
      PsramRegs
    , Rv32Model
    , SimpleRisc
  build-depends: simple-risc, hedgehog
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
